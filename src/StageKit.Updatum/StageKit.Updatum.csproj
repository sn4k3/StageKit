<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Secure GitHub release discovery, download verification, and cross-platform application updates for StageKit applications.</Description>
        <PackageTags>stagekit;updater;auto-update;github-releases;sha256;application-update</PackageTags>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All"/>
        <PackageReference Include="Octokit" Version="14.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\StageKit.Runtime\StageKit.Runtime.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="StageKit.Updatum.Tests">
            <PublicKey></PublicKey>
        </InternalsVisibleTo>
    </ItemGroup>

</Project>
