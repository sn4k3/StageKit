<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>Reusable .NET build pipeline for self-contained publishing, runtime manifests, portable archives, installers, macOS bundles, and Linux distribution packages.</Description>
        <PackageTags>stagekit;build;publishing;bundling;fallout;appimage;flatpak;debian;rpm;archlinux;snap;dmg;pkg;wix;macos</PackageTags>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All"/>
        <PackageReference Include="Fallout.Common" Version="10.4.0"/>
        <PackageReference Include="Fallout.Utilities" Version="10.4.0"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="StageKit.Fallout.Tests, "/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\StageKit.Primitives\StageKit.Primitives.csproj"/>
        <ProjectReference Include="..\StageKit.Runtime\StageKit.Runtime.csproj"/>
    </ItemGroup>

</Project>
