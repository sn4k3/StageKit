    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ObservableCollections" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StageKit.Primitives\StageKit.Primitives.csproj" />
    <ProjectReference Include="..\StageKit.Runtime\StageKit.Runtime.csproj" />
  </ItemGroup>
