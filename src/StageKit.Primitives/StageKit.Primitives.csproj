<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ProductName>StageKit.Primitives</ProductName>
        <Description>Dependency-light .NET primitives for reusable library code, including atomic file writes, path and shell helpers, temporary resources, disposable base types, GC handles, and unmanaged memory wrappers.</Description>
        <PackageTags>stagekit;primitives;disposable;safehandle;atomic-file;utilities</PackageTags>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="StageKit.Tests">
            <PublicKey></PublicKey>
        </InternalsVisibleTo>
    </ItemGroup>

</Project>
