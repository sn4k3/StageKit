<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <Description>Avalonia desktop showcase for StageKit application infrastructure and Updatum.</Description>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

        <FalloutMainProject>true</FalloutMainProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.2"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.2"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0"/>
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\StageKit.Updatum\StageKit.Updatum.csproj"/>
        <ProjectReference Include="..\..\src\StageKit\StageKit.csproj"/>
    </ItemGroup>

</Project>
